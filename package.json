{
  "name": "edge-sidebar-lite",
  "version": "0.3.0",
  "description": "Windows sidebar com escolha de navegador para links externos",
  "main": "src/main.js",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "check": "node --check src/main.js && node --check src/preload.js && node --check src/renderer/app.js",
    "dist:win": "electron-builder --win nsis",
    "test": "node test/layout.test.js && node test/appbar.test.js && node test/browser-links.test.js"
  },
  "build": {
    "appId": "com.geanr.edgesidebarlite",
    "productName": "Edge Sidebar Lite",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Edge Sidebar Lite"
    },
    "artifactName": "${productName}-Setup-${version}-${arch}.${ext}"
  },
  "devDependencies": {
    "electron": "44.7.1",
    "electron-builder": "26.17.0"
  },
  "optionalDependencies": {
    "koffi": "^3.3.3"
  }
}
