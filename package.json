{
  "name": "edge-sidebar-lite",
  "version": "0.4.0-beta.1",
  "description": "Barra lateral Windows com prévia segura de atualizações via GitHub Releases",
  "main": "src/main.js",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "check": "node --check src/main.js && node --check src/preload.js && node --check src/renderer/app.js && node --check src/update-service.js",
    "dist:win": "electron-builder --win nsis --publish never",
    "test": "node test/layout.test.js && node test/appbar.test.js && node test/browser-links.test.js && node test/config-store.test.js && node test/update-service.test.js && node test/signed-release.test.js",
    "lock:sync": "npm install --package-lock-only --ignore-scripts --no-audit --no-fund",
    "lock:verify": "node scripts/verify-lockfile.js",
    "dist:signed": "node scripts/build-signed.js",
    "release:preflight": "node test/signed-release.test.js"
  },
  "build": {
    "appId": "com.geanr.edgesidebarlite",
    "productName": "Edge Sidebar Lite",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Edge Sidebar Lite"
    },
    "artifactName": "${productName}-Setup-${version}-${arch}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "geanjhonatan",
        "repo": "edge-sidebar-lite",
        "releaseType": "release"
      }
    ]
  },
  "devDependencies": {
    "electron": "44.7.1",
    "electron-builder": "26.17.0"
  },
  "optionalDependencies": {
    "koffi": "^3.3.3"
  },
  "dependencies": {
    "electron-updater": "6.8.10"
  }
}
